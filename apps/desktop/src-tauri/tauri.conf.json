{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T-Grid",
  "version": "0.2.0",
  "identifier": "io.textgrideditor.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "T·Grid - TextGrid Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#EAE7E0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
